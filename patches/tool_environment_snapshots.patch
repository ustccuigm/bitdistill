+def _sha256_file(path: str) -> str:
+    digest = hashlib.sha256()
+    with open(path, "rb") as handle:
+        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def _sqlite_state_digest(path: str) -> str:
+    digest = hashlib.sha256()
+    connection = sqlite3.connect(path)
+    try:
+        tables = connection.execute(
+            "SELECT name FROM sqlite_master WHERE type='table' ORDER BY name"
+        ).fetchall()
+        for (table,) in tables:
+            digest.update(table.encode())
+            columns = connection.execute(
+                "SELECT sql FROM sqlite_master WHERE type='table' AND name=?",
+                (table,),
+            ).fetchone()
+            digest.update(repr(columns).encode())
+            quoted_table = '"' + table.replace('"', '""') + '"'
+            for row in connection.execute(f"SELECT * FROM {quoted_table}"):
+                digest.update(repr(row).encode())
+    finally:
+        connection.close()
+    return digest.hexdigest()
+
+
+def _sqlite_backup(source: str, destination: str) -> None:
+    """Create a transaction-consistent SQLite copy, including WAL state."""
+    source_db = sqlite3.connect(source)
+    target_db = sqlite3.connect(destination)
+    try:
+        source_db.backup(target_db)
+    finally:
+        target_db.close()
+        source_db.close()
+
+
+def _write_state_snapshot(
+    root: str,
+    iteration: int,
+    db_path: str,
+    messages: list[dict],
+    trajectory: list[dict],
+    tools_exposed_to_model: bool,
+    run_token: str,
+) -> str:
+    """Persist the complete pre-decision state used by a later intervention."""
+    snapshot = os.path.join(root, f"turn_{iteration:04d}")
+    os.makedirs(snapshot, exist_ok=True)
+    db_target = os.path.join(snapshot, "state.db")
+    temporary_db = db_target + ".tmp"
+    if os.path.exists(temporary_db):
+        os.unlink(temporary_db)
+    _sqlite_backup(db_path, temporary_db)
+    os.replace(temporary_db, db_target)
+    tools_json_save({"messages": messages}, os.path.join(snapshot, "messages.json"))
+    tools_json_save({"trajectory": trajectory}, os.path.join(snapshot, "trajectory.json"))
+    manifest = {
+        "format": 1,
+        "iteration": iteration,
+        "db": "state.db",
+        "messages": "messages.json",
+        "trajectory": "trajectory.json",
+        "db_sha256": _sha256_file(db_target),
+        "state_sha256": _sqlite_state_digest(db_target),
+        "message_count": len(messages),
+        "assistant_turns": sum(message.get("role") == "assistant" for message in messages),
+        "tools_exposed_to_model": tools_exposed_to_model,
+        "run_token": run_token,
+    }
+    tools_json_save(manifest, os.path.join(snapshot, "manifest.json"))
+    return snapshot
+
+
+def _load_state_snapshot(snapshot: str, output_dir: str) -> dict:
+    """Load and verify a snapshot, returning a private writable DB copy."""
+    with open(os.path.join(snapshot, "manifest.json"), encoding="utf-8") as handle:
+        manifest = json.load(handle)
+    source_db = os.path.join(snapshot, manifest["db"])
+    if _sha256_file(source_db) != manifest["db_sha256"]:
+        raise ValueError(f"snapshot database checksum mismatch: {source_db}")
+    restored_db = os.path.join(output_dir, "restored.db")
+    _sqlite_backup(source_db, restored_db)
+    if _sqlite_state_digest(restored_db) != manifest["state_sha256"]:
+        raise ValueError(f"restored database state mismatch: {snapshot}")
+    with open(os.path.join(snapshot, manifest["messages"]), encoding="utf-8") as handle:
+        messages = json.load(handle)["messages"]
+    with open(os.path.join(snapshot, manifest["trajectory"]), encoding="utf-8") as handle:
+        trajectory = json.load(handle)["trajectory"]
+    if len(messages) != manifest["message_count"]:
+        raise ValueError(f"snapshot message count mismatch: {snapshot}")
+    if sum(message.get("role") == "assistant" for message in messages) != manifest["assistant_turns"]:
+        raise ValueError(f"snapshot assistant-turn count mismatch: {snapshot}")
+    return {
+        "db_path": restored_db,
+        "messages": messages,
+        "trajectory": trajectory,
+        "iteration": int(manifest["iteration"]),
+        "tools_exposed_to_model": bool(manifest["tools_exposed_to_model"]),
+        "run_token": str(manifest.get("run_token", "")),
+    }
+
