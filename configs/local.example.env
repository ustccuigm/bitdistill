# Copy to configs/local.env and edit once. Entry points load it automatically.
# This is a trusted Bash file; it is sourced, not parsed as dotenv.
# Keep all custom settings ABOVE the final source command.

STEER_ASSET_ROOT=${STEER_ASSET_ROOT:-$(dirname "$STEERDISTILL_ROOT")/steerdistill-assets}
ENV_ROOT=${ENV_ROOT:-$STEERDISTILL_ROOT/.venv}
INFERENCE_ENV_ROOT=${INFERENCE_ENV_ROOT:-$STEER_ASSET_ROOT/envs/inference}
BENCHMARK_ENV_ROOT=${BENCHMARK_ENV_ROOT:-$STEER_ASSET_ROOT/envs/benchmarks}

# Model: qwen3_8b, qwen3_5_4b, gemma4_12b
# Benchmark: bfcl_v4, tau2_bench, webshop, alfworld, search_qa
MODEL_FAMILY=${MODEL_FAMILY:-qwen3_8b}
BENCHMARK=${BENCHMARK:-bfcl_v4}
GPU_IDS=${GPU_IDS:-0,1,2,3,4,5,6,7}
EVAL_GPU_IDS=${EVAL_GPU_IDS:-0}
EVAL_STEP=${EVAL_STEP:-latest}

# Checkpoints default to $STEER_ASSET_ROOT/models/<model>/<group>.
# Override individual paths here if needed; see docs/benchmarks.md.
# QWEN3_8B_TOOL_USE_MODEL=/path/to/post-rl-checkpoint
# TOOL_ENV_ADAPTER_ROOT="$STEER_ASSET_ROOT/vendor/tool-use-environment"
# TOOL_ENV_BIN=/path/to/tool-environment-executable
# TOOL_ENV_PYTHON=/path/to/python3.12
# CUDA_HOME=/path/to/cuda-toolkit
# SDAR_ROOT="$STEER_ASSET_ROOT/vendor/SDAR"
# SEARCH_RETRIEVER_URL=http://127.0.0.1:8000/retrieve

# Private API settings belong only in configs/local.env, never in this template.
# SERPAPI_API_KEY=...
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=...
# TAU2_USER_MODEL=...

source "$STEERDISTILL_ROOT/configs/steerdistill.example.env"
