# Public configuration template. Model and benchmark assets stay external.
# Export STEER_ASSET_ROOT and ENV_ROOT before sourcing this file.
STEERDISTILL_ROOT=${STEERDISTILL_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}
: "${STEER_ASSET_ROOT:?Set STEER_ASSET_ROOT to the external benchmark asset root}"
: "${ENV_ROOT:?Set ENV_ROOT to the Python environment used by this route}"
INFERENCE_ENV_ROOT=${INFERENCE_ENV_ROOT:-$ENV_ROOT}
BENCHMARK_ENV_ROOT=${BENCHMARK_ENV_ROOT:-$ENV_ROOT}
# Use this when benchmark dependencies live in an external source tree.
BENCHMARK_PYTHONPATH=${BENCHMARK_PYTHONPATH:-}
if [[ -n "$BENCHMARK_PYTHONPATH" ]]; then
  export PYTHONPATH="$BENCHMARK_PYTHONPATH${PYTHONPATH:+:$PYTHONPATH}"
fi
export PYTHONPATH="$STEERDISTILL_ROOT/src${PYTHONPATH:+:$PYTHONPATH}"

BENCHMARK=${BENCHMARK:-bfcl_v4}
MODEL_FAMILY=${MODEL_FAMILY:-qwen3_8b}
source "$STEERDISTILL_ROOT/scripts/lib/select_benchmark.sh"
source "$STEERDISTILL_ROOT/scripts/lib/run_paths.sh"
PROMPT_MANIFEST=${PROMPT_MANIFEST:-$BENCHMARK_PROMPT_MANIFEST}
TOOL_ENV_SOURCE_PATH=${TOOL_ENV_SOURCE_PATH:-$BENCHMARK_SOURCE_ROOT}
TOOL_ENV_ADAPTER_ROOT=${TOOL_ENV_ADAPTER_ROOT:-$STEER_ASSET_ROOT/vendor/tool-use-environment}
TOOL_ENV_BIN=${TOOL_ENV_BIN:-}
TOOL_ENV_RUN_TOKEN=${TOOL_ENV_RUN_TOKEN:-}
CLIP_PATH=${CLIP_PATH:-$CHECKPOINT_ROOT/clip-int4-g64.pt}
TRAIN_DATA_PATH=${TRAIN_DATA_PATH:-$BENCHMARK_RL_TRAIN_DATA}
MODEL_PATH=${MODEL_PATH:-$MODEL_SOURCE_PATH}
TEACHER_MODEL=${TEACHER_MODEL:-$MODEL_SOURCE_PATH}
INITIAL_W4_MASTER=${INITIAL_W4_MASTER:-$MODEL_SOURCE_PATH}
MODEL_SERVING_NAME=${MODEL_SERVING_NAME:-$MODEL_FAMILY_LABEL}

# WebShop, ALFWorld and Search QA use the native SDAR integration by default.
# Optional custom adapters must implement the same audited output contract.
BENCHMARK_ONLINE_DATA_COMMAND=${BENCHMARK_ONLINE_DATA_COMMAND:-}
# Required only for a custom online adapter. The command must
# create exact state snapshots and include their manifest in steer_opd.jsonl.
BENCHMARK_STATE_SNAPSHOT_COMMAND=${BENCHMARK_STATE_SNAPSHOT_COMMAND:-}
BENCHMARK_EVAL_COMMAND=${BENCHMARK_EVAL_COMMAND:-}
TAU2_EVAL_COMMAND=${TAU2_EVAL_COMMAND:-}
SDAR_ROOT=${SDAR_ROOT:-$STEER_ASSET_ROOT/vendor/SDAR}
ALFWORLD_DATA=${ALFWORLD_DATA:-$ALFWORLD_ROOT/data}
SEARCH_TRAIN_PARQUET=${SEARCH_TRAIN_PARQUET:-$SEARCH_QA_ROOT/train.parquet}
SEARCH_EVAL_PARQUET=${SEARCH_EVAL_PARQUET:-$SEARCH_QA_ROOT/test.parquet}
SEARCH_RETRIEVER_URL=${SEARCH_RETRIEVER_URL:-http://127.0.0.1:8000/retrieve}

STREAMING_REPAIR=${STREAMING_REPAIR:-1}
DISCOVERY_ATTEMPTS=${DISCOVERY_ATTEMPTS:-1}
OPD_GLOBAL_BATCH_SIZE=${OPD_GLOBAL_BATCH_SIZE:-16}
OPD_MICRO_BATCH_SIZE=${OPD_MICRO_BATCH_SIZE:-1}
OPD_EPOCHS=${OPD_EPOCHS:-2}
OPD_MAX_STEPS=${OPD_MAX_STEPS:-0}
OPD_SEED=${OPD_SEED:-42}
COUNTERFACTUAL_ATTEMPTS=${COUNTERFACTUAL_ATTEMPTS:-4}
VALIDATION_ATTEMPTS=${VALIDATION_ATTEMPTS:-4}
REPAIR_WORKERS=${REPAIR_WORKERS:-4}
# Number of assistant-turn records in one forward. Global trajectory batches
# remain 16; keeping this at 1 bounds long-context activation memory.
ONLINE_TURN_BATCH_SIZE=${ONLINE_TURN_BATCH_SIZE:-1}
LEARNING_RATE=${LEARNING_RATE:-8e-6}
# Match the Qwen3-8B context window and SteerDistill's public training config.
# Lower this only when a run explicitly trades context coverage for memory.
MODEL_MAX_LENGTH=${MODEL_MAX_LENGTH:-32768}
MAX_TOKENS=${MAX_TOKENS:-32768}
# Per-action output budget for WebShop/ALFWorld; independent of context length.
ACTION_MAX_TOKENS=${ACTION_MAX_TOKENS:-4096}

BASE_PORT=${BASE_PORT:-34000}
WORKERS_PER_ENDPOINT=${WORKERS_PER_ENDPOINT:-8}
MAX_NUM_SEQS=${MAX_NUM_SEQS:-8}
# W4_HOT_ENDPOINTS=http://127.0.0.1:35000,http://127.0.0.1:35001
