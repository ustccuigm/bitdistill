# External benchmark assets. Model weights, RL outputs, environments, and
# evaluation data are intentionally outside the source release.

# The paper shares one BF16 post-RL checkpoint between the two tool-use
# benchmarks. Every other benchmark has its own task-specific checkpoint.
QWEN3_8B_TOOL_USE_MODEL=${QWEN3_8B_TOOL_USE_MODEL:-$STEER_ASSET_ROOT/models/qwen3_8b/tool_use}
QWEN3_8B_WEBSHOP_MODEL=${QWEN3_8B_WEBSHOP_MODEL:-$STEER_ASSET_ROOT/models/qwen3_8b/webshop}
QWEN3_8B_ALFWORLD_MODEL=${QWEN3_8B_ALFWORLD_MODEL:-$STEER_ASSET_ROOT/models/qwen3_8b/alfworld}
QWEN3_8B_SEARCH_QA_MODEL=${QWEN3_8B_SEARCH_QA_MODEL:-$STEER_ASSET_ROOT/models/qwen3_8b/search_qa}

QWEN35_4B_TOOL_USE_MODEL=${QWEN35_4B_TOOL_USE_MODEL:-$STEER_ASSET_ROOT/models/qwen3_5_4b/tool_use}
QWEN35_4B_WEBSHOP_MODEL=${QWEN35_4B_WEBSHOP_MODEL:-$STEER_ASSET_ROOT/models/qwen3_5_4b/webshop}
QWEN35_4B_ALFWORLD_MODEL=${QWEN35_4B_ALFWORLD_MODEL:-$STEER_ASSET_ROOT/models/qwen3_5_4b/alfworld}
QWEN35_4B_SEARCH_QA_MODEL=${QWEN35_4B_SEARCH_QA_MODEL:-$STEER_ASSET_ROOT/models/qwen3_5_4b/search_qa}

GEMMA4_12B_TOOL_USE_MODEL=${GEMMA4_12B_TOOL_USE_MODEL:-$STEER_ASSET_ROOT/models/gemma4_12b/tool_use}
GEMMA4_12B_WEBSHOP_MODEL=${GEMMA4_12B_WEBSHOP_MODEL:-$STEER_ASSET_ROOT/models/gemma4_12b/webshop}
GEMMA4_12B_ALFWORLD_MODEL=${GEMMA4_12B_ALFWORLD_MODEL:-$STEER_ASSET_ROOT/models/gemma4_12b/alfworld}
GEMMA4_12B_SEARCH_QA_MODEL=${GEMMA4_12B_SEARCH_QA_MODEL:-$STEER_ASSET_ROOT/models/gemma4_12b/search_qa}

BENCHMARK_ASSET_ROOT=${BENCHMARK_ASSET_ROOT:-$STEER_ASSET_ROOT/benchmarks}
BFCL_V4_ROOT=${BFCL_V4_ROOT:-$BENCHMARK_ASSET_ROOT/bfcl_v4}
TAU2_BENCH_ROOT=${TAU2_BENCH_ROOT:-$BENCHMARK_ASSET_ROOT/tau2_bench}
WEBSHOP_ROOT=${WEBSHOP_ROOT:-$BENCHMARK_ASSET_ROOT/webshop}
ALFWORLD_ROOT=${ALFWORLD_ROOT:-$BENCHMARK_ASSET_ROOT/alfworld}
SEARCH_QA_ROOT=${SEARCH_QA_ROOT:-$BENCHMARK_ASSET_ROOT/search_qa}

BFCL_V4_RL_TRAIN_DATA=${BFCL_V4_RL_TRAIN_DATA:-$BFCL_V4_ROOT/rl_train.jsonl}
BFCL_V4_CLIP_DATA=${BFCL_V4_CLIP_DATA:-$BFCL_V4_RL_TRAIN_DATA}
BFCL_V4_PROMPT_MANIFEST=${BFCL_V4_PROMPT_MANIFEST:-$BFCL_V4_ROOT/prompts.jsonl}
BFCL_V4_SOURCE_ROOT=${BFCL_V4_SOURCE_ROOT:-$BFCL_V4_ROOT/environment}

TAU2_BENCH_RL_TRAIN_DATA=${TAU2_BENCH_RL_TRAIN_DATA:-$BFCL_V4_RL_TRAIN_DATA}
TAU2_BENCH_CLIP_DATA=${TAU2_BENCH_CLIP_DATA:-$TAU2_BENCH_RL_TRAIN_DATA}
TAU2_BENCH_PROMPT_MANIFEST=${TAU2_BENCH_PROMPT_MANIFEST:-$BFCL_V4_PROMPT_MANIFEST}
TAU2_BENCH_SOURCE_ROOT=${TAU2_BENCH_SOURCE_ROOT:-$BFCL_V4_SOURCE_ROOT}

WEBSHOP_RL_TRAIN_DATA=${WEBSHOP_RL_TRAIN_DATA:-$WEBSHOP_ROOT/rl_train.jsonl}
WEBSHOP_CLIP_DATA=${WEBSHOP_CLIP_DATA:-$WEBSHOP_RL_TRAIN_DATA}
WEBSHOP_PROMPT_MANIFEST=${WEBSHOP_PROMPT_MANIFEST:-$WEBSHOP_RL_TRAIN_DATA}
WEBSHOP_SOURCE_ROOT=${WEBSHOP_SOURCE_ROOT:-$WEBSHOP_ROOT/environment}

ALFWORLD_RL_TRAIN_DATA=${ALFWORLD_RL_TRAIN_DATA:-$ALFWORLD_ROOT/rl_train.jsonl}
ALFWORLD_CLIP_DATA=${ALFWORLD_CLIP_DATA:-$ALFWORLD_RL_TRAIN_DATA}
ALFWORLD_PROMPT_MANIFEST=${ALFWORLD_PROMPT_MANIFEST:-$ALFWORLD_RL_TRAIN_DATA}
ALFWORLD_SOURCE_ROOT=${ALFWORLD_SOURCE_ROOT:-$ALFWORLD_ROOT/environment}

SEARCH_QA_RL_TRAIN_DATA=${SEARCH_QA_RL_TRAIN_DATA:-$SEARCH_QA_ROOT/rl_train.jsonl}
SEARCH_QA_CLIP_DATA=${SEARCH_QA_CLIP_DATA:-$SEARCH_QA_RL_TRAIN_DATA}
SEARCH_QA_PROMPT_MANIFEST=${SEARCH_QA_PROMPT_MANIFEST:-$SEARCH_QA_RL_TRAIN_DATA}
SEARCH_QA_SOURCE_ROOT=${SEARCH_QA_SOURCE_ROOT:-$SEARCH_QA_ROOT/environment}
